# ============================================================================
# Copy this file to `.env.local` for local development.
# In production, set the same keys in your host's environment variables UI.
# `.env.local` is gitignored — never commit real tokens.
# ============================================================================

# Your production origin, no trailing slash. Used for canonical URLs + sitemap.
NEXT_PUBLIC_SITE_URL=https://primemobiledetails.com

# --- Instagram --------------------------------------------------------------
# LEAVE THIS BLANK. As of 27 Aug 2026 this site deliberately does not call the
# Instagram API — the six tiles come from `instagramFallback` in site.config.js.
# See the long comment there for the reasoning.
#
# Setting a token is NOT enough to get a live feed on this deployment. We ship a
# static export, so server components run once at build time; the feed would be
# frozen at whatever the last Amplify build fetched. Making it genuinely live
# needs BOTH:
#   1. a scheduled Amplify rebuild (EventBridge -> build webhook), and
#   2. something that refreshes the 60-day token and writes the new one back
#      into Amplify's environment variables — a refresh mints a NEW token that
#      has to be stored somewhere.
#
# (An earlier version of this file referenced an /api/instagram/refresh route
# and a Vercel CRON_SECRET. That route never existed here and route handlers
# can't exist in a static export. Both have been removed.)
INSTAGRAM_ACCESS_TOKEN=

# --- Optional: analytics ----------------------------------------------------
# Plausible or Fathom domain, if you use one. Leave blank to disable.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
