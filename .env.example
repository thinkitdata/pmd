# ============================================================================
# Copy this file to `.env.local` for local development.
# In production, set the same keys in your host's environment variables UI.
# `.env.local` is gitignored — never commit real tokens.
# ============================================================================

# Your production origin, no trailing slash. Used for canonical URLs + sitemap.
NEXT_PUBLIC_SITE_URL=https://primemobiledetails.com

# --- Instagram --------------------------------------------------------------
# A long-lived Instagram access token (Instagram API with Instagram Login).
# Valid 60 days; the /api/instagram/refresh route renews it automatically.
# Leave blank and the site falls back to a curated static grid — the section
# still looks right, it just isn't live.
INSTAGRAM_ACCESS_TOKEN=

# --- Cron protection --------------------------------------------------------
# Any long random string. Vercel Cron sends it as a Bearer token so the
# refresh endpoint can't be hit by anyone else.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# --- Optional: analytics ----------------------------------------------------
# Plausible or Fathom domain, if you use one. Leave blank to disable.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
